# ── .env ─────────────────────────────────────────
PORT=2161

# ADMIN
ADMIN_EMAIL="admin@eneles.example"

# RESEND
RESEND_API_KEY=""
RESEND_WEBHOOK_SECRET=""
EMAIL_FROM="Eneles <noreply@eneles.example>"
CONTACT_TO="Eneles <contact@eneles.example>"

# AI
AI_CHAT_PROVIDER=""
ANTHROPIC_API_KEY=""
ANTHROPIC_CHAT_MODEL=""
OPENAI_API_KEY=""
OPENAI_CHAT_MODEL=""
AXYA_SERVICE_URL=""


# ── .env.development / .env.production ───────────
NODE_ENV=""
DOMAIN_NAME=""

# COMPILER
COMPILER_INTERNAL_SECRET=""
INTERNAL_API_SECRET=""

# POSTGRES
# DATABASE_URL is defined below using the Eneles Supabase session pooler.

# REDIS
REDIS_URL=""

# BUCKETS
## ASSETS
ASSETS_BUCKET_NAME=""
ASSETS_BUCKET_REGION=""
ASSETS_BUCKET_ENDPOINT_URL=""
ASSETS_BUCKET_ACCESS_KEY_ID=""
ASSETS_BUCKET_SECRET_ACCESS_KEY=""

## BUILDS
BUILDS_BUCKET_NAME=""
BUILDS_BUCKET_REGION=""
BUILDS_BUCKET_ENDPOINT_URL=""
BUILDS_BUCKET_ACCESS_KEY_ID=""
BUILDS_BUCKET_SECRET_ACCESS_KEY=""

# ENELES SHARED SUPABASE POSTGRES
# Use the Supabase session pooler for the Archives project. Prisma models live
# in the isolated, server-only "atelier" schema.
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@<POOLER_HOST>:5432/postgres?schema=atelier"

# ENELES CLOUDFLARE R2 (server-side only; use a PRIVATE bucket for Atelier data)
# Keep the public lsnb-documents bucket for published public documents only.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="eneles-atelier-private"
R2_REGION="auto"
# Optional override; defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=""

# STRIPE
# Paid plans are on sale only when this is exactly "true". Unset or anything else: Billing shows "coming soon", checkout and restarting a plan are refused, and the Free plan works as usual. A production server also refuses a test key (sk_test_) here.
BILLING_PLANS_ACTIVE="false"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
## PRICE IDS
### PRO PLAN
STRIPE_PRO_MONTHLY_PRICE_ID=""
STRIPE_PRO_YEARLY_PRICE_ID=""
### TEAM PLAN
STRIPE_TEAM_MONTHLY_PRICE_ID=""
STRIPE_TEAM_YEARLY_PRICE_ID=""

# ENELES SINGLE SIGN-ON (Supabase Auth)
ENELES_SUPABASE_URL="https://tdeotqfsbvouresfhkab.supabase.co"
ENELES_SUPABASE_ANON_KEY=""
ALLOWED_ORIGINS="https://YOUR-ATELIER-FRONTEND.up.railway.app,https://aurore-section-archives.com,https://aurore-section-archivescom.vercel.app"
SESSION_COOKIE_DOMAIN=""

# JWT
JWT_SECRET=""
JWT_EXPIRATION=604800s

# LLM API KEY SEAL
AI_KEY_SECRET=""

# OPTIONAL
# METRICS_TOKEN=""
# REVIEWER_EMAILS=""
# GITHUB_TOKEN_KEY=""
# SESSION_COOKIE_DOMAIN=""
# TRUST_PROXY_HOPS=1
